---
---

<header class="fixed top-0 left-0 right-0 bg-white/90 backdrop-blur-md border-b border-gray-800 shadow-xs" style="z-index: 1000;">
    <div class="px-4 py-3 flex justify-between items-center gap-4">
        <div class="flex items-center gap-3">
            <div class="brand-mark">
                <span>🍕</span>
            </div>
            <div>
                <h1 class="text-xl md:text-2xl font-bold text-gray-900 tracking-tight"><a href="/" title="MargMap">MargMap</a></h1>
                <p class="hidden md:block text-sm text-gray-600">Rating the one true Pizza</p>
            </div>
        </div>
        <div class="hidden lg:flex flex-1 max-w-md ml-auto">
            <label for="header-search-input" class="sr-only">Search Restaurants</label>
            <div class="relative w-full">
                <button id="header-locate-me" type="button" aria-label="Use my location" class="absolute left-3 top-1/2 -translate-y-1/2 inline-flex h-6 w-6 items-center justify-center rounded-full bg-gray-900 text-white hover:bg-gray-700 transition">
                    <svg class="w-3.5 h-3.5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21s-5-4.35-5-9a5 5 0 1110 0c0 4.65-5 9-5 9z"></path>
                        <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"></circle>
                    </svg>
                </button>
                <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-gray-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </span>
                <input type="text" id="header-search-input" placeholder="Search by name, city, or country..." class="w-full border border-gray-800 bg-white/90 rounded-full pl-12 pr-11 py-2.5 text-sm text-gray-900 shadow-xs focus:outline-hidden focus:ring-2 focus:ring-gray-700" />
            </div>
        </div>
        <button id="mobile-menu-toggle" class="lg:hidden text-gray-600 hover:text-gray-900" aria-label="Open filters and restaurant list">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>
</header>
