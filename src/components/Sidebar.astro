---
---

<aside class="fixed bottom-0 left-0 right-0 lg:right-0 lg:left-auto lg:bottom-0 lg:w-96 lg:flex hidden bg-white/95 backdrop-blur-sm shadow-xl border-l border-gray-800 max-h-[60vh] lg:max-h-[calc(100vh-var(--header-height))] flex-col app-sidebar" style="z-index: 1000;">
    <!-- Main Content (Stats, Filters, List) -->
    <div id="sidebar-main-content" class="p-4 flex flex-col flex-1 overflow-hidden">
        <!-- Stats Cards -->
        <section class="grid grid-cols-2 gap-2 mb-4 shrink-0">
            <article class="bg-white rounded-xl shadow-xs border border-gray-800 p-3">
                <h2 class="text-xs font-medium text-gray-600 uppercase">Showing</h2>
                <p class="text-2xl font-bold text-gray-900 mt-1" id="total-count">0</p>
                <p class="text-xs text-gray-500 mt-1" id="total-count-context">of 0 total spots</p>
            </article>
            <article class="bg-white rounded-xl shadow-xs border border-gray-800 p-3">
                <h2 class="text-xs font-medium text-gray-600 uppercase">Avg Shown</h2>
                <p class="text-2xl font-bold text-gray-900 mt-1" id="avg-rating">0</p>
                <p class="text-xs text-gray-500 mt-1">Based on visible results</p>
            </article>
            <article class="bg-white rounded-xl shadow-xs border border-gray-800 p-3">
                <h2 class="text-xs font-medium text-gray-600 uppercase">Best Shown</h2>
                <p class="text-sm font-bold text-gray-900 mt-1" id="top-restaurant">-</p>
            </article>
            <article class="bg-white rounded-xl shadow-xs border border-gray-800 p-3">
                <h2 class="text-xs font-medium text-gray-600 uppercase">Countries Shown</h2>
                <p class="text-2xl font-bold text-gray-900 mt-1" id="country-count">0</p>
            </article>
        </section>

        <!-- Filters -->
        <section class="bg-white rounded-xl shadow-xs border border-gray-800 p-3 mb-4 shrink-0">
            <div class="space-y-2">
                <div>
                    <label for="country-filter" class="block text-xs font-medium text-gray-700 mb-1">Country</label>
                    <select id="country-filter" class="w-full border border-gray-700 rounded-md px-2 py-1 text-sm focus:outline-hidden focus:ring-2 focus:ring-gray-700">
                        <option value="">All Countries</option>
                    </select>
                </div>
                <div>
                    <label for="sort-by" class="block text-xs font-medium text-gray-700 mb-1">Sort by</label>
                    <select id="sort-by" class="w-full border border-gray-700 rounded-md px-2 py-1 text-sm focus:outline-hidden focus:ring-2 focus:ring-gray-700">
                        <option value="rating-desc">Rating (High to Low)</option>
                        <option value="rating-asc">Rating (Low to High)</option>
                        <option value="date-desc">Date (Newest)</option>
                        <option value="date-asc">Date (Oldest)</option>
                        <option value="price-desc">Price (High to Low)</option>
                        <option value="price-asc">Price (Low to High)</option>
                        <option value="value-desc">Value (High to Low)</option>
                        <option value="value-asc">Value (Low to High)</option>
                    </select>
                </div>
                <div>
                    <label for="rating-min" class="block text-xs font-medium text-gray-700 mb-1">Minimum Rating</label>
                    <div class="flex items-center space-x-2">
                        <input type="range" id="rating-min" min="0" max="10" value="0" step="0.1" class="flex-1" />
                        <span class="text-xs text-gray-600" id="rating-display">0+</span>
                    </div>
                    <div class="flex justify-between text-xs text-gray-500 mt-1">
                        <span>0</span>
                        <span>10</span>
                    </div>
                </div>
                <button id="clear-filters" type="button" class="hidden w-full rounded-md border border-gray-800 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition">Clear Filters</button>
            </div>
        </section>

        <!-- Restaurants List -->
        <section class="bg-white rounded-xl shadow-xs border border-gray-800 overflow-hidden flex-1 flex flex-col min-h-0">
            <div class="px-3 py-2 border-b border-gray-700 bg-gray-50/70 flex items-center justify-between gap-3">
                <h3 class="text-sm font-semibold text-gray-900">Visible Restaurants</h3>
                <span id="results-count" class="text-xs font-medium text-gray-500">0 shown</span>
            </div>
            <div class="overflow-y-auto flex-1">
                <div id="restaurants-list" class="divide-y divide-gray-200">
                    <!-- Populated by JavaScript -->
                </div>
            </div>
        </section>
    </div>

    <!-- Detail View (Full Sidebar) -->
    <div id="sidebar-detail-view" class="hidden h-full flex flex-col">
        <!-- Header with close button -->
        <div class="p-4 border-b border-gray-700 flex justify-between items-center shrink-0">
            <h2 class="text-xl font-bold text-gray-900" id="sidebar-detail-name"></h2>
            <button id="close-sidebar-detail" class="text-gray-400 hover:text-gray-600 p-1" aria-label="Close restaurant detail panel">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Scrollable content -->
        <div class="flex-1 overflow-y-auto p-4">
            <div id="sidebar-detail-photo-shell" class="detail-photo-shell mb-6 hidden">
                <div id="sidebar-detail-photo" class="detail-photo is-empty">
                    <div class="detail-photo-placeholder">Photo unavailable</div>
                </div>
                <div id="sidebar-detail-photo-attribution" class="detail-photo-attribution hidden"></div>
            </div>

            <!-- Key Info -->
            <div class="grid grid-cols-3 gap-4 mb-6">
                <div>
                    <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">Rating</div>
                    <div class="text-3xl font-bold text-gray-900" id="sidebar-detail-rating"></div>
                </div>
                <div>
                    <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">Value</div>
                    <div class="text-3xl font-bold text-gray-900" id="sidebar-detail-value"></div>
                </div>
                <div>
                    <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">Price</div>
                    <div class="text-3xl font-bold text-gray-900" id="sidebar-detail-price"></div>
                </div>
                <div class="col-span-3">
                    <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">Location</div>
                    <a id="sidebar-detail-location" href="#" target="_blank" rel="noopener noreferrer" class="text-base font-medium text-blue-600 hover:text-blue-800 inline-flex items-center gap-1">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span></span>
                    </a>
                </div>
                <div class="col-span-3">
                    <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">Date Visited</div>
                    <div class="text-base font-medium text-gray-900" id="sidebar-detail-date"></div>
                </div>
            </div>

            <!-- Detailed Ratings -->
            <div>
                <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-3">Detailed Ratings</h3>
                <div id="sidebar-detail-ratings" class="space-y-3">
                    <!-- Populated by JavaScript -->
                </div>
            </div>
        </div>
    </div>
</aside>
