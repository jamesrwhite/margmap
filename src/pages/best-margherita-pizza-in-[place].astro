---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import { slugify } from '../lib/slug.js';
import { MIN_RATINGS } from '../lib/bestPages.js';

function getRatingColorHex(mScore) {
    const score = parseFloat(mScore);
    if (score >= 8) return '#ef4444';
    if (score >= 7) return '#f97316';
    if (score >= 6) return '#eab308';
    return '#6b7280';
}

export async function getStaticPaths() {
    const TOP_N = 5;

    function groupBy(restaurants, keyFn) {
        const groups = new Map();
        for (const restaurant of restaurants) {
            const key = keyFn(restaurant);
            if (!groups.has(key)) groups.set(key, []);
            groups.get(key).push(restaurant);
        }
        return groups;
    }

    const dataPath = path.resolve('public/data/ratings.json');
    const restaurants = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));

    const byLocation = groupBy(restaurants, (r) => r.Location);
    const byCountry = groupBy(restaurants, (r) => r.Country);

    const paths = new Map();

    for (const [location, list] of byLocation) {
        if (list.length < MIN_RATINGS) continue;
        const slug = slugify(location);
        paths.set(slug, {
            params: { place: slug },
            props: {
                name: location,
                subtitle: list[0].Country,
                totalCount: list.length,
                restaurants: list.slice().sort((a, b) => b.mScore - a.mScore).slice(0, TOP_N),
            },
        });
    }

    for (const [country, list] of byCountry) {
        if (list.length < MIN_RATINGS) continue;
        const slug = slugify(country);
        if (paths.has(slug)) continue;
        const locationCount = new Set(list.map((r) => r.Location)).size;
        paths.set(slug, {
            params: { place: slug },
            props: {
                name: country,
                subtitle: `${locationCount} location${locationCount === 1 ? '' : 's'}`,
                totalCount: list.length,
                restaurants: list.slice().sort((a, b) => b.mScore - a.mScore).slice(0, TOP_N),
            },
        });
    }

    return Array.from(paths.values());
}

const { name, subtitle, totalCount, restaurants } = Astro.props;
const title = `Best Margherita Pizza in ${name} — MargMap`;
const description = `The top ${restaurants.length} highest-rated Margherita pizzas in ${name}, out of ${totalCount} rated on MargMap.`;
---

<Layout title={title} description={description}>
    <div class="min-h-screen px-4 py-8 sm:px-8 sm:py-12">
        <div class="mx-auto max-w-2xl">
            <a href="/" class="inline-flex items-center gap-1 text-sm font-medium text-blue-600 hover:text-blue-800">
                &larr; Back to map
            </a>

            <h1 class="mt-4 text-3xl font-bold text-gray-900">Best Margherita Pizza in {name}</h1>
            <p class="mt-1 text-base text-gray-600">{subtitle} &middot; top {restaurants.length} of {totalCount} rated pizzerias</p>

            <ol class="mt-8 space-y-3">
                {restaurants.map((restaurant, index) => {
                    const href = `/r/${slugify(restaurant.Country)}/${slugify(restaurant.Location)}/${slugify(restaurant.Name)}/`;
                    const ratingColor = getRatingColorHex(restaurant.mScore);
                    return (
                        <li>
                            <a href={href} class="flex items-center justify-between gap-4 panel-callout hover:bg-gray-50 transition-colors">
                                <div class="flex items-center gap-4 min-w-0">
                                    <span class="text-lg font-semibold text-gray-400 w-6 shrink-0 text-right">{index + 1}</span>
                                    <div class="min-w-0">
                                        <div class="text-base font-semibold text-gray-900 truncate">{restaurant.Name}</div>
                                        <div class="text-sm text-gray-500">{restaurant.Price}</div>
                                    </div>
                                </div>
                                <div class="text-2xl font-bold shrink-0" style={`color: ${ratingColor}`}>{restaurant.mScore}</div>
                            </a>
                        </li>
                    );
                })}
            </ol>
        </div>
    </div>
</Layout>

<style is:global>
    /* The app shell sets html/body to overflow: hidden for the full-screen map page;
       this page needs normal document scrolling. */
    html,
    body {
        overflow: auto;
        height: auto;
    }
</style>
