{
    "name": "margmap",
    "version": "1.0.0",
    "description": "A web application for visualizing and rating pizza places on an interactive map",
    "packageManager": "pnpm@11.20.0",
    "type": "module",
    "scripts": {
        "dev": "pnpm prepare-data && astro dev",
        "build": "pnpm prepare-data && astro build && pnpm update-readme",
        "check": "pnpm prepare-data && astro build",
        "preview": "pnpm prepare-data && astro build && wrangler dev --port 8788",
        "ship": "pnpm build && wrangler deploy",
        "prepare-data": "node scripts/csv-to-json.js src/data/ratings.csv public/data/ratings.json",
        "enrich-google-places": "node scripts/enrich-google-places.js",
        "fetch-csv": "mkdir -p src/data && curl -sL \"https://docs.google.com/spreadsheets/d/11YkHrgVDMG8CW5mtdGxlV74Qi1aJNiABADpsDP4eEfQ/export?format=csv&id=11YkHrgVDMG8CW5mtdGxlV74Qi1aJNiABADpsDP4eEfQ&gid=0\" | tr -d '\\r' > src/data/ratings.csv",
        "fetch-data": "pnpm fetch-csv && pnpm prepare-data",
        "update-readme": "node scripts/update-readme-table.js",
        "update-data": "pnpm fetch-csv && pnpm enrich-google-places && pnpm prepare-data && pnpm update-readme",
        "clean": "rm -f src/data/ratings.csv public/data/ratings.json && rm -rf dist"
    },
    "dependencies": {
        "maplibre-gl": "6.4.1"
    },
    "devDependencies": {
        "@astrojs/cloudflare": "^14.2.0",
        "@astrojs/sitemap": "^3.7.3",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.2.0",
        "csv-parse": "^7.0.2",
        "tailwindcss": "^4.3.3",
        "wrangler": "4.116.0"
    },
    "private": true
}
